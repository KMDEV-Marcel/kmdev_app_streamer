# Caddy als HTTPS-Reverse-Proxy vor dem Node-Signaling-Server,
# ausgelegt fuer Cloudflare (Proxy an, SSL-Modus "Full (strict)").
#
# 1. In Cloudflare ein Origin-Zertifikat erstellen
#    (SSL/TLS -> Origin Server -> Create Certificate) und als
#    certs\origin.pem / certs\origin.key neben diese Datei legen.
# 2. Domain und Pfade unten anpassen.
# 3. caddy run --config Caddyfile   (bzw. per install-server.ps1 als Dienst)

{
	# Zertifikat kommt von Cloudflare, Caddy soll kein eigenes holen
	# und keinen HTTP->HTTPS-Redirect auf Port 80 starten.
	auto_https off
}

stream.example.com:443 {
	tls C:/kmdev-stream/server/certs/origin.pem C:/kmdev-stream/server/certs/origin.key

	# Signaling (WebSocket) + Health-Check an Node weiterreichen.
	handle /ws {
		reverse_proxy 127.0.0.1:8443
	}
	handle /health {
		reverse_proxy 127.0.0.1:8443
	}

	handle {
		respond "KMDev Stream" 200
	}
}
