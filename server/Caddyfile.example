# Caddy als HTTPS-Reverse-Proxy vor dem Node-Signaling-Server,
# ausgelegt fuer Cloudflare (Proxy an, SSL-Modus "Full (strict)").
#
# 1. In Cloudflare ein Origin-Zertifikat erstellen
#    (SSL/TLS -> Origin Server -> Create Certificate) und als
#    certs\origin.pem / certs\origin.key neben diese Datei legen.
# 2. Domain und Pfade unten anpassen.
# 3. install-server.ps1 laedt Caddy und richtet es als Dienst ein.

{
	# Zertifikat kommt von Cloudflare, Caddy soll kein eigenes holen
	# und keinen HTTP->HTTPS-Redirect auf Port 80 starten.
	auto_https off
}

stream.example.com:{$KMDEV_HTTPS_PORT:443} {
	# Relativ zum Server-Ordner (der Dienst startet mit diesem Arbeitsverzeichnis).
	tls certs/origin.pem certs/origin.key

	# Signaling (WebSocket) + Health-Check an Node weiterreichen. Den Port setzt
	# install-server.ps1 passend zu config.json (Umgebungsvariable).
	handle /ws {
		reverse_proxy 127.0.0.1:{$KMDEV_SIGNAL_PORT:8443}
	}
	handle /health {
		reverse_proxy 127.0.0.1:{$KMDEV_SIGNAL_PORT:8443}
	}

	handle {
		respond "KM-DEV Stream" 200
	}
}
