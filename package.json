{
  "name": "kmdev-stream",
  "version": "0.1.1",
  "description": "P2P-Bildschirmübertragung mit Auto-Update",
  "main": "main.js",
  "author": "Marcel Kari",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "release": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.0.5"
  },
  "build": {
    "appId": "de.km-dev.stream",
    "productName": "KM-DEV Stream",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "renderer/**",
      "build/icon.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "KM-DEV Stream",
      "artifactName": "KM-DEV-Stream-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "KMDEV-Marcel",
        "repo": "kmdev_app_streamer",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KMDEV-Marcel/kmdev_app_streamer.git"
  }
}
